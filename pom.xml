<?xml version="1.0" encoding="UTF-8"?>
<!--
  TotalPOS Bridge — Java/Javalin REST server that wraps the TotalPOS SDK
  running on a Windows mini-PC. Exposes the SDK's transactional operations
  (venta, anulación, QR, cierre, carga de llaves, reportes) via HTTP/JSON
  so the kiosk Flutter app can talk to it across the LAN.

  Targets Java 17 because:
    1. The TotalPOS SDK is compiled to Java 8 bytecode (we verified major
       version 52 in its class files), so target ≥8 works.
    2. The integrator's mini-PC already has JDK 17 installed (it's what
       the SDK currently runs on natively, where its HTTP stack works).
    3. Java 17 records make the request/response DTOs much cleaner.

  The SDK jar is vendored under `libs-repo/` in a Maven-layout local
  repository (group/artifact/version/jar+pom). The pom below declares that
  directory as a project-scoped repository, so the dependency resolves
  during the normal compile phase and the shade plugin packs it into the
  fat jar — no manual `mvn install:install-file` step required for anyone
  who clones the repo.

  The original raw jar is kept at `libs/totalpos_sdk-1.1.13.jar` for
  visibility / re-vendoring if BBVA ships a new version: copy it to
  `libs-repo/com/eglobal/totalpos-sdk/X.Y.Z/totalpos-sdk-X.Y.Z.jar` along
  with a sibling `.pom` file, then bump the version in the dependency
  block below.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.notariapaino</groupId>
    <artifactId>totalpos-bridge</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>TotalPOS Bridge</name>
    <description>REST wrapper for the TotalPOS SDK running on a Windows mini-PC</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Dependency versions, grouped for visibility -->
        <javalin.version>6.4.0</javalin.version>
        <jackson.version>2.17.2</jackson.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.12</logback.version>
        <snakeyaml.version>2.3</snakeyaml.version>
        <sqlite.version>3.46.1.3</sqlite.version>
    </properties>

    <repositories>
        <!--
          Project-local Maven repository for the vendored TotalPOS SDK jar.
          Maven resolves the dependency below against this directory at
          dependency-resolution time (before any plugin executes), so the
          jar is available for compile and gets shaded into the fat jar
          without any setup step.
        -->
        <repository>
            <id>project-local</id>
            <name>Vendored TotalPOS SDK</name>
            <url>file://${project.basedir}/libs-repo</url>
            <releases>
                <enabled>true</enabled>
                <checksumPolicy>ignore</checksumPolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!--
          TotalPOS SDK 1.1.13 — vendored under libs-repo/ in Maven layout.
          See the repositories block above and the comment at the top of
          this pom for how to vendor a new version.
        -->
        <dependency>
            <groupId>com.eglobal</groupId>
            <artifactId>totalpos-sdk</artifactId>
            <version>1.1.13</version>
        </dependency>

        <!-- HTTP server -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>

        <!-- JSON (Jackson — already used by Javalin internally) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- YAML loader for application.yaml -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- SQLite for local persistence of turno transactions -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>totalpos-bridge</finalName>
        <plugins>
            <!--
              Build a single executable fat jar at
              `target/totalpos-bridge.jar` with all dependencies (including
              the TotalPOS SDK) shaded inside. Deployment to the mini-PC
              is one file + application.yaml.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.notariapaino.bridge.Main</mainClass>
                                </transformer>
                                <!-- Merge META-INF/services/* from all deps so SLF4J finds Logback. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Drop signature files that would otherwise invalidate the shaded jar. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
