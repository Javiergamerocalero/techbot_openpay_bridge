<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback config for the TotalPOS Bridge.

  We keep this DISTINCT from the SDK's own LogManager output: the SDK writes
  its native protocol log to `{rutaBase}/totalpos/logs/totalpos_sdk_java_*.log`
  (that's the one BBVA cert reviews). Logback here is for the BRIDGE's own
  diagnostic messages — startup, request routing, IO errors, etc.

  Two appenders: stdout (visible when running interactively) and a rolling
  file at `logs/bridge.log` rotated daily, 14-day retention.
-->
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/bridge.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/bridge-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Quiet down chatty libraries we don't need to debug. -->
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="io.javalin.Javalin" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
